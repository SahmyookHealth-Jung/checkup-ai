# --- 비밀값: 절대 커밋하지 않는다 ---
.env
.env.*
!.env.example

# --- Gradle / Java ---
.gradle/
build/
!**/src/**/build/
*.class
hs_err_pid*

# --- IDE / OS ---
.idea/
*.iml
.vscode/
.metadata/
.project
.classpath
.settings/
out/
bin/
.DS_Store

# --- Claude Code 개인 설정 ---
.claude/settings.local.json
# archify 스킬이 만든 다이어그램 출력 (평가 기록의 dirty 판정에 걸리지 않게 뺀다)
.archify/

# --- Python (eval) ---
__pycache__/
*.pyc
.venv/
.pytest_cache/
# LLM 응답 캐시 (중복 과금 방지용, 재생성 가능)
eval/.cache/

# --- Frontend ---
node_modules/
frontend/dist/

# --- Data: 원문 문서는 다운로드 스크립트로 받는다 (재배포 조건이 문서마다 다름) ---
data/guidelines/raw/
# 합성 결과지 PDF: macOS 폰트가 임베드되므로 커밋하지 않고 같은 시드로 다시 만든다 (eval/README.md)
data/synthetic/**/*.pdf

# --- Logs ---
*.log

# 해설 근거 청크 (원문에서 다시 만든다. 포털 글은 공공누리 제4유형이라 올리지 않는다)
data/guidelines/chunks/

# 기능 2 통계 데이터 원본 (공공데이터포털, ADR 0013). 내려받아 쓰고 커밋하지 않는다
data/stats/raw/
